# ==============================================================================
# KnowBridge AI Backend — Environment Configuration Template (.env.example)
# Note: Copy this file to backend/.env and replace placeholder values with actual credentials.
# Never commit .env to version control.
# ==============================================================================

# Application Settings
PROJECT_NAME="KnowBridge AI Backend"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Configuration (Supabase PostgreSQL Session Pooler via psycopg v3)
# Individual connection components
DB_HOST=aws-1-ap-southeast-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.iwwleppesznhdecsickr
DB_PASSWORD=[YOUR-ACTUAL-PASSWORD]

# Database Connection URL (Preferred single source of truth for SQLAlchemy & psycopg v3)
# Format: postgresql+psycopg://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
DATABASE_URL=postgresql+psycopg://postgres.iwwleppesznhdecsickr:[YOUR-ACTUAL-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

# Connection Pooling Configuration
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=5
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Supabase Storage Configuration (Task 04)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]
STORAGE_BUCKET_NAME=knowledge-documents

# Embedding Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
